<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1">
<title>WISEMAN — Crafted for the Wise</title>
<link rel="preconnect" href="https://fonts.googleapis.com">
<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
<link href="https://fonts.googleapis.com/css2?family=Cormorant+Garamond:ital,wght@0,500;0,600;0,700;1,500&family=Inter:wght@400;500;600&family=Noto+Sans+Bengali:wght@600;700&display=swap" rel="stylesheet">
<style>
:root{--p:#6a2c9e;--pd:#2a0f45;--bg:#ffffff;--ink:#1a1a1f;--muted:#6b6b75;--tint:#f7f4fb;--chip:#f4eefa;--red:#f0435a;--line:#e8e4ee}
*{box-sizing:border-box;margin:0;padding:0}
html{background:#fff}
body{min-height:100vh;font-family:'Inter',system-ui,sans-serif;background:var(--bg);color:var(--ink);font-size:14px;line-height:1.4}
a{color:inherit;text-decoration:none}
button{font-family:inherit;cursor:pointer}
img{display:block;max-width:100%}
.wrap{width:100%;max-width:none;margin:0;padding:0 clamp(16px,2.4vw,40px)}

/* top bar + header */
.topbar{background:var(--pd);color:#fff;text-align:center;font-size:11.5px;padding:7px 10px;letter-spacing:.2px}
header{background:#fff}
.hrow{display:flex;align-items:center;gap:28px;padding:14px 0 0}
.hrow .search{flex:1;min-width:0}
.hrow .logo,.hrow .hright{flex:none}
.hrow .logo img{height:30px;width:auto}
.hright{display:flex;align-items:center;gap:16px;font-size:12px;color:#333}
.hright .ico{position:relative;display:inline-flex;align-items:center;gap:4px}
.hright .cnt{position:absolute;top:-9px;right:-12px;background:var(--p);color:#fff;border-radius:50%;font-size:9px;width:15px;height:15px;display:flex;align-items:center;justify-content:center}
.login{background:#fff;color:#000;border:0;border-radius:8px;padding:10px 20px;font-weight:600;font-size:13px}
.search{display:flex;border:1px solid var(--line);border-radius:8px;overflow:hidden;background:#fff}
.search input{flex:1;border:0;padding:12px 14px;font:inherit;font-size:13px;outline:0;background:#fff}
.search button{background:var(--p);color:#fff;border:0;padding:0 30px;font-weight:600;font-size:13px}
nav{display:flex;gap:26px;padding:14px 0 0;font-size:13px;overflow-x:auto;white-space:nowrap}
nav a{padding-bottom:12px;border-bottom:2px solid transparent;color:#222}
nav a.on{color:var(--p);border-color:var(--p)}
nav a sup{font-size:8px;color:#888;margin-left:2px}

/* hero */
.hero{position:relative;margin:16px 0 0;border-radius:14px;overflow:hidden;line-height:0}
.hero img{width:100%;height:auto}
.hero .shopnow{position:absolute;left:6.6%;bottom:6.2%;line-height:1;background:var(--p);color:#fff;border:1.5px solid var(--p);border-radius:8px;font-weight:600;letter-spacing:.6px;text-transform:uppercase;
  font-size:clamp(9px,1.25vw,14px);padding:clamp(7px,1.1vw,13px) clamp(14px,2.1vw,26px);transition:.2s}
.hero .shopnow:hover{background:#fff;color:var(--p)}

/* sections */
.sec{padding-top:56px}
.stitle{font-family:'Cormorant Garamond',serif;font-weight:700;font-size:44px;line-height:1.05;letter-spacing:.2px;color:var(--p)}
.stag{font-size:15px;font-weight:400;color:var(--muted);margin-top:8px}
.sec>.stag{margin-bottom:22px}
.sechead{display:flex;align-items:flex-end;justify-content:space-between;margin-bottom:22px}
.arrows{display:flex;gap:8px}
.arrows button{width:32px;height:32px;border-radius:50%;border:1px solid #ddd;background:#fff;font-size:16px;line-height:1;color:#222}
.arrows.dark button{background:transparent;border-color:rgba(255,255,255,.35);color:#fff}

/* category / feature cards */
.sgrid{display:grid;gap:16px}
.sgrid.c3{grid-template-columns:repeat(3,1fr)}
.sgrid.c4{grid-template-columns:repeat(4,1fr)}
.scard{color:var(--ink);background:#fff;border-radius:12px;overflow:hidden;box-shadow:0 2px 12px rgba(40,20,70,.14);display:block}
.simg{aspect-ratio:1/1;overflow:hidden;background:#fff}
.simg img{width:100%;height:100%;object-fit:cover}
.sfoot{display:flex;justify-content:space-between;align-items:center;padding:14px 12px;font-size:13px;font-weight:500}
.sfoot em{font-style:normal;color:var(--p);font-size:12px;font-weight:500}

/* product cards */
.track{display:flex;gap:16px;overflow-x:auto;scroll-behavior:smooth;scrollbar-width:none;padding-bottom:4px}
.track::-webkit-scrollbar{display:none}
.pcard{color:var(--ink);flex:0 0 max(200px,calc((100% - (var(--n,5) - 1)*16px)/var(--n,5)));background:#fff;border-radius:12px;overflow:hidden;box-shadow:0 2px 12px rgba(40,20,70,.14);display:flex;flex-direction:column}
.pimg{position:relative;aspect-ratio:1/1;background:#fff}
.pimg img{width:100%;height:100%;object-fit:cover}
.badge{position:absolute;top:10px;right:0;background:var(--red);color:#fff;font-size:9.5px;font-weight:600;padding:3px 9px;border-radius:4px 0 0 4px}
.wish{position:absolute;right:10px;bottom:10px;width:28px;height:28px;border-radius:50%;border:0;background:#fff;color:var(--p);display:flex;align-items:center;justify-content:center;box-shadow:0 1px 5px rgba(0,0,0,.2)}
.pbody{padding:12px 12px 4px;flex:1}
.pbody h3{font-size:12.5px;font-weight:500;line-height:1.3;min-height:32px;color:#1a1a1f}
.price{margin-top:4px;display:flex;align-items:baseline;gap:6px}
.price b{font-size:15px;font-weight:600}
.price s{font-size:11px;color:#999}
.sizes{display:flex;flex-wrap:nowrap;gap:4px;margin-top:8px;min-height:22px}
.sizes span{border:1px solid #ddd;border-radius:5px;font-size:9px;padding:3px 5px;color:#444}
.actions{display:flex;gap:8px;padding:12px}
.cartbtn{width:34px;height:34px;border:1.3px solid var(--p);background:#fff;border-radius:8px;color:var(--p);display:flex;align-items:center;justify-content:center;flex:none}
.buy{flex:1;height:34px;border:1.3px solid var(--p);background:#fff;color:var(--p);border-radius:8px;font-weight:600;font-size:12.5px;transition:.2s}
.buy:hover,.cartbtn:hover{background:var(--p);color:#fff}
.best .pcard{flex:1}
.bgrid{display:grid;grid-template-columns:repeat(4,1fr);gap:16px}

/* flash sale */
.flash{margin-top:56px;background:linear-gradient(120deg,#2e114b 0%,#682b9b 100%);padding:46px 0 44px;color:#fff}
.flabel{display:inline-block;font-size:11px;letter-spacing:2px;text-transform:uppercase;font-weight:500;color:#fff;opacity:.85;margin-bottom:6px}
.flash .stitle{color:#fff}
.flash .stag{color:rgba(255,255,255,.85)}
.fhead{display:flex;align-items:flex-start;justify-content:space-between;gap:20px;margin-bottom:24px;flex-wrap:wrap}
.fleft{display:flex;align-items:center;gap:36px;flex-wrap:wrap}
.cd{display:flex;gap:8px}
.cd div{background:rgba(255,255,255,.18);border-radius:8px;width:48px;padding:7px 0 6px;text-align:center}
.cd b{display:block;font-size:19px;font-weight:600}
.cd small{font-size:8px;letter-spacing:1px;opacity:.8}

/* reviews */
.rgrid{display:grid;grid-template-columns:repeat(4,1fr);gap:16px}
.rcard{background:#fff;border-radius:12px;box-shadow:0 2px 12px rgba(40,20,70,.14);padding:22px 20px 20px;display:flex;flex-direction:column;gap:14px}
.stars{color:#f2a516;font-size:16px;letter-spacing:2px;line-height:1}
.rcard p{flex:1;font-size:14px;line-height:1.6;color:#33323a}
.rwho{display:flex;align-items:center;gap:12px;padding-top:14px;border-top:1px solid var(--line)}
.av{flex:none;width:38px;height:38px;border-radius:50%;background:var(--chip);color:var(--p);font-weight:600;font-size:15px;display:flex;align-items:center;justify-content:center}
.rwho b{display:block;font-size:13.5px;font-weight:600}
.rwho small{display:block;font-size:12px;color:var(--muted)}

/* delivery banner */
.dbanner{margin-top:40px;border-radius:14px;border:1px solid var(--line);overflow:hidden;line-height:0}
.dbanner img{width:100%;height:auto;aspect-ratio:1920/540}
.deliv{margin-top:40px;background:var(--tint);border-radius:14px;padding:28px 28px 26px}
.deliv h3{font-family:'Noto Sans Bengali',sans-serif;font-size:24px;font-weight:700;color:#1b1b1f}
.deliv p{color:var(--muted);font-size:13.5px;margin:6px 0 18px}
.chips{display:flex;gap:10px;flex-wrap:wrap}
.chips span{border:1px solid var(--p);color:var(--p);border-radius:6px;font-size:11px;font-weight:500;padding:9px 13px;letter-spacing:.3px}

/* trust + newsletter + footer (sample colors) */
:root{--navy:#2a0f45;--navyink:#3b2557;--f1:#f3edf9;--f2:#ece3f6;--f3:#e2d6f0}
.lightwrap{background:#fff;margin-top:70px}
.trust{background:var(--f1);color:var(--navy)}
.trustin{display:grid;grid-template-columns:repeat(4,1fr);align-items:center;padding-top:32px;padding-bottom:32px}
.ti{display:flex;align-items:center;gap:16px;padding:0 24px;border-left:1.5px solid #d6c8e8}
.ti:first-child{border-left:0;padding-left:0}
.ti .ic{flex:none;display:flex;color:var(--navy)}
.ti b{display:block;font-size:15px;font-weight:600;color:var(--navy)}
.ti small{color:#5d4b73;font-size:13px;line-height:1.35;display:block}
.news{background:#fff}
.newsin{display:flex;align-items:center;justify-content:space-between;gap:24px;padding-top:38px;padding-bottom:38px;flex-wrap:wrap}
.news h3{font-family:'Cormorant Garamond',serif;font-size:42px;font-weight:600;color:var(--navy);line-height:1.1}
.news p{color:#5d4b73;font-size:16px;margin-top:4px}
.nform{display:flex;gap:18px;flex:1;max-width:980px;min-width:280px}
.nform input{flex:1;border:1px solid #d9cce9;border-radius:10px;padding:0 24px;height:64px;font:inherit;font-size:18px;background:#fff;color:var(--navy)}
.nform button{background:var(--navy);color:#fff;border:0;border-radius:8px;padding:0 40px;height:64px;font-weight:600;font-size:17px}
.foot{background:var(--f2);color:var(--navyink)}
.fgrid{display:grid;grid-template-columns:1.5fr 1fr 1fr 1.25fr;gap:40px;padding:48px 0 46px clamp(0px,7vw,140px)}
.fgrid h4{font-size:18px;letter-spacing:.3px;color:var(--navy);font-weight:700;margin-bottom:22px;padding-bottom:6px;position:relative}
.fgrid h4:after{content:"";position:absolute;left:0;bottom:-2px;width:34px;height:2px;background:var(--navy)}
.fgrid ul{list-style:none}
.fgrid li{font-size:16px;margin-bottom:12px;color:var(--navyink)}
.brand .logo img{height:42px;mix-blend-mode:multiply}
.brand .tag{font-family:'Cormorant Garamond',serif;font-style:italic;color:var(--navyink);font-size:26px;margin:12px 0 10px}
.brand p{color:var(--navyink);font-size:16px;max-width:380px;line-height:1.5}
.social{display:flex;align-items:center;gap:12px;margin-top:22px;font-size:16px;color:var(--navy)}
.social b{font-weight:600;margin-right:2px}
.social a{width:42px;height:42px;border-radius:50%;border:1.5px solid var(--navy);display:inline-flex;align-items:center;justify-content:center;color:var(--navy);transition:.2s}
.social a svg{width:19px;height:19px}
.social a:hover{background:var(--navy);color:#fff}
.crow{display:flex;gap:14px;align-items:flex-start;margin-bottom:18px;font-size:16px;color:var(--navyink)}
.crow .ci{color:var(--navy);margin-top:2px;flex:none}
.crow b{display:block;font-weight:700;color:var(--navy)}
.crow div span{display:block}
.accept{background:var(--f3);border-top:1px solid #d3c5e6}
.acin{display:flex;align-items:center;justify-content:space-between;gap:16px;flex-wrap:wrap;padding-top:16px;padding-bottom:16px}
.pay{display:flex;align-items:center;gap:10px;flex-wrap:wrap}
.pay>span{font-size:15px;letter-spacing:1.5px;color:var(--navy);margin-right:8px;font-weight:500}
.pay img{height:46px;width:auto;border-radius:8px;display:block}
.pay i{font-style:normal;background:#fff;color:var(--navy);border-radius:6px;padding:11px 16px;font-size:13px;font-weight:600}
.plinks{display:flex;align-items:center;padding:0;gap:0;overflow:visible}
.plinks a{border:0;padding:0 16px;color:var(--navyink);font-size:15px;border-left:1.5px solid #a392b8}
.plinks a:first-child{border-left:0}
.plinks a:last-child{padding-right:0}
.copy{background:var(--navy);color:#fff;font-size:15px}
.copy .wrap{padding-top:22px;padding-bottom:22px}

@media (max-width:820px){
  .sgrid.c4,.bgrid,.rgrid{grid-template-columns:repeat(2,1fr)}
  .trustin{grid-template-columns:repeat(2,1fr);row-gap:22px}
  .ti:nth-child(odd){border-left:0;padding-left:0}
  .fgrid{grid-template-columns:1fr 1fr}
  .hrow{gap:14px;flex-wrap:wrap}
  .hrow .search{order:3;flex-basis:100%}
  .hrow .logo{margin-right:auto}
  .news h3{font-size:34px}
  .stitle{font-size:32px}
  .hright .txt{display:none}
}
@media (max-width:560px){
  .sgrid.c3{grid-template-columns:1fr}
  .fgrid{grid-template-columns:1fr}
  .trustin{grid-template-columns:1fr}
  .ti,.ti:nth-child(odd){border-left:0;padding-left:0}
  .pcard{flex-basis:170px!important}
  .hero .shopnow{left:5%;bottom:4%}
}

/* premium layer */
.wrap{max-width:1440px;margin-left:auto;margin-right:auto}
header{position:sticky;top:0;z-index:60;box-shadow:0 1px 0 var(--line)}
nav{gap:34px;letter-spacing:.4px}
.hero,.dbanner{border-radius:4px}
.hero .shopnow,.search,.search button,.login{border-radius:3px}
.sec{padding-top:84px}
.flash{margin-top:84px;padding:60px 0 56px}
.dbanner{margin-top:84px}
.stitle{font-size:46px}
.stag{font-size:16px}
.vall{margin-left:auto;margin-right:18px;align-self:flex-end;font-size:13px;font-weight:600;color:var(--p);letter-spacing:.4px;border-bottom:1.5px solid var(--p);padding-bottom:2px}
.sechead{align-items:flex-end}
.scard,.pcard{border-radius:4px;box-shadow:none;transition:.3s}
.pcard{border:1px solid var(--line)}
.pcard:hover{border-color:var(--p);box-shadow:0 10px 28px rgba(42,15,69,.12)}
.scard{position:relative}
.simg{aspect-ratio:4/5}
.sfoot{position:absolute;left:0;right:0;bottom:0;padding:70px 24px 22px;background:linear-gradient(transparent,rgba(26,8,44,.82));color:#fff;font-family:'Cormorant Garamond',serif;font-size:26px;font-weight:700}
.sfoot em{color:#fff;font-family:'Inter',sans-serif;font-size:12px;font-weight:500;letter-spacing:.8px;border-bottom:1px solid rgba(255,255,255,.7)}
.quick{display:flex;gap:10px;flex-wrap:wrap;margin-top:22px}
.quick a{border:1px solid var(--p);color:var(--p);border-radius:30px;padding:9px 20px;font-size:12.5px;font-weight:500;transition:.2s}
.quick a:hover{background:var(--p);color:#fff}
.pbody h3{font-size:14px}
.price b{font-size:16px}
.buy{background:var(--pd);border-color:var(--pd);color:#fff;border-radius:3px;height:38px;font-size:12px;letter-spacing:.8px;text-transform:uppercase}
.buy:hover{background:var(--p);border-color:var(--p)}
.cartbtn{border-radius:3px;width:38px;height:38px}
.badge{border-radius:2px 0 0 2px}
.reviews{background:var(--tint);box-shadow:0 0 0 100vmax var(--tint);clip-path:inset(0 -100vmax);margin-top:84px;padding-bottom:84px}
.rcard{border:1px solid var(--line);box-shadow:none;border-radius:4px}
.lightwrap{margin-top:0}
.trust{border-top:1px solid var(--line)}
.wa{position:fixed;right:20px;bottom:20px;z-index:70;width:54px;height:54px;border-radius:50%;background:#25d366;display:flex;align-items:center;justify-content:center;box-shadow:0 6px 18px rgba(0,0,0,.28)}
@media (max-width:820px){.sec,.flash,.dbanner,.reviews{margin-top:0}.sec{padding-top:60px}.flash{margin-top:60px}.stitle{font-size:34px}.vall{margin-right:10px}}
@media (max-width:560px){.stitle{font-size:30px}.sizes{flex-wrap:wrap;min-height:0}.sizes span{font-size:11px;padding:4px 8px}.pbody h3{font-size:14px}.buy,.cartbtn{height:44px}.cartbtn{width:44px}.sechead{flex-wrap:wrap;gap:10px}.wa{right:14px;bottom:14px}}
</style>
</head>
<body>

<div class="topbar">Delivery all over Bangladesh &nbsp;·&nbsp; Cash on Delivery &nbsp;·&nbsp; Easy Exchange</div>

<header>
  <div class="wrap">
    <div class="hrow">
      <a class="logo" href="#"><img src="data:image/png;base64," alt="WISEMAN"></a>
      <form class="search" onsubmit="return false"><input type="text" placeholder="I am shopping for…"><button>Search</button></form>
      <div class="hright">
        <span class="ico">&#9825; <span class="txt">Wishlist</span><span class="cnt">0</span></span>
        <span class="ico"><span class="txt">Cart</span><span class="cnt">0</span></span>
        <button class="login">Login</button>
      </div>
    </div>
    <nav>
      <a class="on" href="#">Home</a>
      <a href="#">Men’s Apparel<sup>▾</sup></a>
      <a href="#">Kids Apparels<sup>▾</sup></a>
      <a href="#">Accessories<sup>▾</sup></a>
      <a href="#mega">Mega Deals</a>
    </nav>
  </div>
</header>

<main class="wrap">
  <div class="hero">
    <img src="data:image/jpeg;base64," alt="নতুন কালেকশন — স্টাইলিশ প্যান্ট — ফ্যাশন যে কথা বলে">
    <a class="shopnow" href="#">Shop Now &rarr;</a>
  </div>

  <section class="sec">
    <h2 class="stitle">Shop by Category</h2>
    <p class="stag">Discover your fashion and essentials</p>
    <div class="sgrid c3"><a class="scard" href="#"><div class="simg"><img src="data:image/jpeg;base64," alt="Men’s Apparel"></div><div class="sfoot"><span>Men’s Apparel</span><em>Shop now &rarr;</em></div></a><a class="scard" href="#"><div class="simg"><img src="data:image/jpeg;base64," alt="Kids Apparels"></div><div class="sfoot"><span>Kids Apparels</span><em>Shop now &rarr;</em></div></a><a class="scard" href="#"><div class="simg"><img src="data:image/jpeg;base64," alt="Accessories"></div><div class="sfoot"><span>Accessories</span><em>Shop now &rarr;</em></div></a></div>
    <div class="quick"><a href="#">Under ৳999</a><a href="#">New In</a><a href="#">Best Sellers</a><a href="#">Gift Sets</a></div>
  </section>

  <section class="sec">
    <div class="sechead">
      <div><h2 class="stitle">New Arrivals</h2><p class="stag">Discover what’s new in style</p></div>
      <a class="vall" href="#">View all &rarr;</a><div class="arrows" data-target="t1"><button aria-label="Previous">&lsaquo;</button><button aria-label="Next">&rsaquo;</button></div>
