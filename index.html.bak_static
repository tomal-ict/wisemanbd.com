<script>
document.querySelectorAll('.arrows').forEach(function(a){
  var t=document.getElementById(a.dataset.target), b=a.querySelectorAll('button');
  b[0].onclick=function(){t.scrollBy({left:-t.clientWidth*.8})};
  b[1].onclick=function(){t.scrollBy({left:t.clientWidth*.8})};
});
(function(){
  var left=7*86400, D=document.getElementById('d'), H=document.getElementById('h'), M=document.getElementById('m'), S=document.getElementById('s');
  function p(n){return String(n).padStart(2,'0')}
  setInterval(function(){ if(left>0) left--; D.textContent=p(Math.floor(left/86400)); H.textContent=p(Math.floor(left%86400/3600)); M.textContent=p(Math.floor(left%3600/60)); S.textContent=p(left%60); },1000);
})();
</script>
